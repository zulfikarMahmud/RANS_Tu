FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseSettings"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    // omegaWallFunction is part of the SST near-wall treatment.  The kko/kkos
    // (kkLOmega) cases correctly use zeroGradient instead -- that difference is
    // model-required, not an inconsistency.
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    airfoil
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    sides
    {
        type            empty;
    }
}

