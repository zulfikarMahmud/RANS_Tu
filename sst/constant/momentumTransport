FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType RAS;

RAS
{
    model           kOmegaSST;

    turbulence      on;
    printCoeffs     on;

    // Menter production limiter, tightened from the SST-2003 default c1=10.
    // MUST sit in the RAS dict: OpenFOAM 13 resolves coeffDict() via
    // optionalSubDict(type()+"Coeffs"), which silently falls back to the
    // parent RAS dict -- entries inside kOmegaSSTCoeffs are NOT read.
    // Limiter binds at S > sqrt(c1*betaStar)*omega. Equilibrium turbulent BL
    // sits at S = 0.300*omega, so c1=5 -> 0.671*omega, a 2.24x margin.
    // At Tu=0.1% the stagnation amplification is 1.0, so this is expected to
    // be near-inert here -- applied for consistency with the higher-Tu cases.
    c1              5;

    // Plain SST-2003 coefficients (defaults shown for clarity). No LM/transition
    // coeffs here — this is kOmegaSST, not kOmegaSSTLM.
    kOmegaSSTCoeffs
    {
        alphaK1       0.85;
        alphaK2       1.0;
        alphaOmega1   0.5;
        alphaOmega2   0.856;
        beta1         0.075;
        beta2         0.0828;
        betaStar      0.09;
        gamma1        5/9;
        gamma2        0.44;
        a1            0.31;
        b1            1.0;
        F3            no;
    }
}


