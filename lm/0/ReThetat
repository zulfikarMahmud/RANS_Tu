FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      ReThetat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseSettings"

dimensions      [0 0 0 0 0 0 0]; // Dimensionless scalar

internalField   uniform $ReThetatInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField; // Exactly matching Tu = 0.1% correlation
    }

    outlet
    {
        type            zeroGradient;
    }

    airfoil
    {
        type            zeroGradient;
         
    }

    sides
    {
        type            empty;
    }
}


