FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseSettings"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinlet;

boundaryField
{
    inlet
    {
        type            freestreamVelocity;
	freestreamValue $internalField;
    }

    outlet
    {
        type            freestreamVelocity;
	freestreamValue $internalField;
    }

    airfoil
    {
        type            noSlip;
    }

    sides
    {
        type            empty;
    }
}

