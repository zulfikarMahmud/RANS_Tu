FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//  omega_inlet = kInlet/nutInlet (from caseSettings), matching the SST/LM cases.
//  Wall: zeroGradient — the low-Re kkLOmega integrates omega to the wall
//  (OpenFOAM elipsekkLOmega tutorial convention).
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseSettings"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    // WALL BC IS MODEL-SPECIFIC -- DO NOT "fix" THIS FOR CONSISTENCY.
    // kkLOmega/kkLOmegaS integrate to the wall and carry their own explicit
    // near-wall omega source (Cw3*fOmega*alphaT*fw^2*sqrt(kt)/y^3 in
    // kkLOmega.C), so omega takes zeroGradient at the wall.  The SST family
    // (sst/lm/ysst) instead uses omegaWallFunction, which is part of Menter's
    // near-wall blending.  OpenFOAM 13's own kkLOmega tutorial
    // (tutorials/incompressibleFluid/elipsekkLOmega) uses zeroGradient too.
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    airfoil
    {
        type            zeroGradient;
    }

    sides
    {
        type            empty;
    }
}

