FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      kl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//  kl = large-scale (laminar / pre-transitional) kinetic energy. It is ZERO in
//  the freestream and only grows inside the boundary layer, so kl_inlet = 0.
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    outlet
    {
        type            zeroGradient;
    }

    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }

    sides
    {
        type            empty;
    }
}

